# TDX client credentials. Copy this file to .env and fill in the values.
# Never commit the real .env file.
CLIENT_ID=
CLIENT_SECRET=

# Optional: only needed if the collector later uses TDX MQTT.
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=

# Dashboard runtime. The demo container does not need TDX credentials.
HOST=0.0.0.0
PORT=8000
# TAAS_DATA_DIR=/app/data/demo

